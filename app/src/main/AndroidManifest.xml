<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Serverga (kompyuterdagi botga) ulanish uchun -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Geo-tagli kamera ekrani uchun -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Narkomonitor"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic="true": LAN ichida http://192.168.x.x:8080 kabi
          shifrlanmagan manzildan ulanish uchun kerak (ngrok https bo'lsa ham
          muammo yo'q, lekin oddiy Wi-Fi LAN manzili http bo'lgani uchun shart).
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".LoginCodeActivity"
            android:exported="false"
            android:label="@string/login_code_title" />

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/camera_title" />

    </application>
</manifest>
