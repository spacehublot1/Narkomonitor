<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telegram tasdiqlash kodi"
        android:textColor="@color/brand_amber"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textPhoneLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_ink"
        android:textSize="13sp"
        android:alpha="0.8"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Telegram'dan kelgan kod"
        android:inputType="number"
        android:autofillHints="" />

    <EditText
        android:id="@+id/editPassword2fa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Ikki bosqichli (2FA) parol"
        android:inputType="textPassword"
        android:visibility="gone"
        android:autofillHints="" />

    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tasdiqlash" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/brand_ink"
        android:textSize="13sp" />

</LinearLayout>
